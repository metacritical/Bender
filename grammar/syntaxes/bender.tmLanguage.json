    },
    "braces": {
      "begin": "(@?\\{)",
      "beginCaptures": {"1": {"name": "punctuation.definition.braces.begin.bender"}},
      "end": "(\\})",
      "endCaptures": {"1": {"name": "punctuation.definition.braces.end.bender"}},
      "patterns": [{"include": "#all"}]
