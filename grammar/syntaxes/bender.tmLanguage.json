    "longstring": {
      "begin": "(@?)(`+)",
      "beginCaptures": {
        "1": {"name": "punctuation.definition.string.begin.bender"},
        "2": {"name": "punctuation.definition.string.begin.bender"}
      },
      "end": "\\2",
      "endCaptures": {"0": {"name": "punctuation.definition.string.end.bender"}},
      "name": "string.quoted.triple.bender"
    },
    "readermac": {
      "match": "['~;,]",
      "name": "punctuation.other.readermacro.bender"
    },
    "parens": {
      "begin": "(@?\\()",
      "beginCaptures": {"1": {"name": "punctuation.definition.parens.begin.bender"}},
      "end": "(\\))",
      "endCaptures": {"1": {"name": "punctuation.definition.parens.end.bender"}},
