    "longstring": {
      "begin": "(@?)(`+)",
      "beginCaptures": {
        "1": {"name": "punctuation.definition.string.begin.bender"},
        "2": {"name": "punctuation.definition.string.begin.bender"}
      },
      "end": "\\2",
      "endCaptures": {"0": {"name": "punctuation.definition.string.end.bender"}},
      "name": "string.quoted.triple.bender"
