    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.bender",
      "captures": {"1": {"name": "punctuation.definition.comment.bender"}}
    },
    "string": {
      "begin": "(@?\")",
      "beginCaptures": {"1": {"name": "punctuation.definition.string.begin.bender"}},
      "end": "\"",
      "endCaptures": {"0": {"name": "punctuation.definition.string.end.bender"}},
      "name": "string.quoted.double.bender",
      "patterns": [
        {"match": "(\\\\[nevr0zft\"\\\\']|\\\\x[0-9a-fA-F]{2}|\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{6})",
