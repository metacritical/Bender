# Add this to github-linguist/linguist: lib/linguist/languages.yml
# Keep entries in ASCII order. Do not add `language_id` manually; run
# `script/update-ids` instead.
Bender:
  type: programming
  color: "#9aa7b0"
  extensions:
  - ".ben"
  tm_scope: source.bender
  ace_mode: scheme
  codemirror_mode: scheme
  codemirror_mime_type: text/x-scheme
  interpreters:
  - bender
