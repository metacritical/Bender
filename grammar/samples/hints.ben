# {:hint} contracts let the compiler emit a native numeric kernel.

(defn add
  {:hint {:params [:double :double] :returns :double}}
  [x y]
  (+ x y))

(defn sum
  {:hint {:params [[:double]] :returns :double}}
  [xs]
  (var acc 0.0)
  (for i 0 (length xs)
    (+= acc (xs i)))
  acc)

(defn main
  [& args]
  (def xs @[1.0 2.0 3.0 4.0])
  (printf "add = %.1f" (add 20.0 22.0))
  (printf "sum = %.1f" (sum xs)))
