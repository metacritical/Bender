# Bounded same-definition closures with distinct captured environments.
# stdout deterministic; timings and optional exact executor evidence on stderr.
(defn make-capturing-loop [bias]
  (fn capturing-loop [n]
    (var i 0)
    (var sum 0)
    (while (< i n)
      (set sum (+ sum (+ i bias)))
      (set i (+ i 1)))
    sum))
(def args (dyn :args))
(def n (if (get args 1) (scan-number (get args 1)) 10000))
(def rounds (if (get args 2) (scan-number (get args 2)) 100))
(assert (and (number? n) (= n (math/floor n)) (>= n 1) (<= n 1000000))
        "n must be an integer in [1,1000000]")
(assert (and (number? rounds) (= rounds (math/floor rounds)) (>= rounds 1) (<= rounds 1000))
        "rounds must be an integer in [1,1000]")
(assert (<= (* n rounds) 10000000) "n * rounds cap is 10000000")
(def started (os/clock :monotonic))
(def left (make-capturing-loop 3))
(def right (make-capturing-loop 7))
(assert (not (= left right)) "factory must produce distinct closure objects")
(assert (= (left 2) 7) "left capture corrupted")
(assert (= (right 2) 15) "right capture corrupted")
(assert (= (left 2) 7) "same-def attachment reused another closure's environment")
(def prepared (os/clock :monotonic))
(var checksum 0)
(var r 0)
(while (< r rounds)
  (set checksum (+ checksum (left n)))
  (set checksum (+ checksum (right n)))
  (set r (+ r 1)))
(def finished (os/clock :monotonic))
(def expected (* rounds (+ (* n (- n 1)) (* 10 n))))
(assert (= checksum expected) "capturing-loop checksum mismatch")
(printf "n=%d rounds=%d checksum=%d" n rounds checksum)
(eprintf "phase=closure-load setup_ms=%.3f work_ms=%.3f total_ms=%.3f"
         (* 1000 (- prepared started)) (* 1000 (- finished prepared))
         (* 1000 (- finished started)))
# Optional third argument: exact capturing-loop ID from native-executors.txt.
(def sentry (or (get (curenv) 'native/executor-stats) (get (curenv) 'executor-stats)))
(def gentry (or (get (curenv) 'native/executor-global-stats) (get (curenv) 'executor-global-stats)))
(when gentry
  (def global-stats (if (function? gentry) gentry (gentry :value)))
  (def gs (global-stats))
  (eprintf "executor-global attempts=%d attached=%d ambiguous=%d nomatch=%d registry=%d"
           (gs 0) (gs 1) (gs 2) (gs 3) (gs 5)))
(when (get args 3)
  (assert sentry "executor ID requested but executor-stats unavailable")
  (def id (scan-number (get args 3)))
  (assert (and (number? id) (= id (math/floor id)) (>= id 0)) "invalid executor ID")
  (def stats (if (function? sentry) sentry (sentry :value)))
  (def counts (stats id))
  (eprintf "executor-target id=%d entries=%d backedges=%d guards=%d ops=%d vmexits=%d"
           id (counts 0) (counts 1) (counts 2) (counts 3) (counts 4))
  (assert (> (counts 0) 0) "target executor never entered")
  (assert (> (counts 1) 0) "target executor executed no loop backedges")
  (assert (> (counts 3) 0) "target executor executed no native ops"))
