 static BENDER_THREAD_LOCAL int32_t bender_gc_epoch = 0;
 
+/* Spawn-scaling probe (development only; compiled in solely with
+ * -DBENDER_GC_PROBE, never in a shipped build).
+ *
+ * It exists to separate the only two ways a collector can cost O(N) per
+ * spawn: the NUMBER of collections, or the WORK inside each one. Wall
+ * clock alone cannot tell those apart, and docs/internals/proc-spawn-scaling.md
+ * records two "fixes" that were adopted against wall clock and later
+ * measured 5x and 58x WORSE, so attribution here is deliberately
+ * mechanical rather than inferred.
+ *
+ * Counters are per-collection thread-local (the mark counter sits in the
+ * hottest loop in the collector, so it must not be atomic) and are folded
+ * into process-wide totals once per collection. Lane threads each fold
+ * their own; the totals are therefore relaxed-atomic sums and are
+ * attribution-grade, not a determinism contract. */
+#ifdef BENDER_GC_PROBE
+static BENDER_THREAD_LOCAL uint64_t bender_probe_marks_cur = 0;
+static uint64_t bender_probe_marks = 0;        /* mark-macro hits, all collections */
+static uint64_t bender_probe_marks_max = 0;    /* largest single collection */
+static uint64_t bender_probe_fm = 0;           /* scoped fiber minors that marked */
+static uint64_t bender_probe_fm_skip = 0;      /* scoped minors short-circuited */
+static uint64_t bender_probe_pm = 0;           /* per-process (strict) minors */
+static uint64_t bender_probe_gm = 0;           /* global minors */
+static uint64_t bender_probe_major = 0;        /* full collects */
+static uint64_t bender_probe_blocks = 0;       /* block_count at the last minor */
+static uint64_t bender_probe_thresh = 0;       /* trigger threshold last used */
+/* Marks attributed to the collection KIND that performed them. Without this
+ * split a total mark count cannot distinguish "many cheap scoped minors"
+ * from "a few whole-heap majors", which are opposite diagnoses. */
+static uint64_t bender_probe_marks_fm = 0;
+static uint64_t bender_probe_marks_pm = 0;
+static uint64_t bender_probe_marks_gm = 0;
+static uint64_t bender_probe_marks_major = 0;
+/* Marks attributed to each ROOT SUBPATH of a scoped fiber minor. The scoped
+ * minor has exactly six mark sources; only measuring them separately can say
+ * which one grows with the live process set. */
+static uint64_t bender_probe_sp_own = 0;       /* bender_mark_fiber(f) */
+static uint64_t bender_probe_sp_dyns = 0;      /* top_dyns */
+static uint64_t bender_probe_sp_prof = 0;      /* profile_table */
+static uint64_t bender_probe_sp_reg = 0;       /* proc_registry */
+static uint64_t bender_probe_sp_ev = 0;        /* bender_ev_mark_shallow */
+static uint64_t bender_probe_sp_xfb = 0;       /* bender_xfb_mark_owned */
+/* Fibers marked per collection. The proc-capture depth cap (proc.h:50) is
+ * supposed to keep this O(1) inside a scoped minor; if it grows with the
+ * live process count the cap is not actually binding. */
+static BENDER_THREAD_LOCAL uint64_t bender_probe_fibers_cur = 0;
+static uint64_t bender_probe_fibers_fm = 0;
+static uint64_t bender_probe_fibers_max = 0;
+/* How many collections exceed the documented proc-chain bound, and how much
+ * fiber-walking they account for. This is the quadratic term if it is real. */
+static uint64_t bender_probe_big_count = 0;
+static uint64_t bender_probe_big_fibers = 0;
+static int bender_probe_on = -1;
+
+#define BENDER_PROBE_ADD(p, v) __atomic_fetch_add(&(p), (uint64_t)(v), __ATOMIC_RELAXED)
+#define BENDER_PROBE_SET(p, v) __atomic_store_n(&(p), (uint64_t)(v), __ATOMIC_RELAXED)
+#define BENDER_PROBE_MARK() (++bender_probe_marks_cur)
+
+static void bender_probe_report(void) {
+    if (bender_probe_on != 1) return;
+    uint64_t fm = __atomic_load_n(&bender_probe_fm, __ATOMIC_RELAXED);
+    uint64_t marks = __atomic_load_n(&bender_probe_marks, __ATOMIC_RELAXED);
+    uint64_t mfm = __atomic_load_n(&bender_probe_marks_fm, __ATOMIC_RELAXED);
+    fprintf(stderr,
+            "[gc-probe] fiber_minor=%llu skipped=%llu proc_minor=%llu "
+            "global_minor=%llu major=%llu marks=%llu marks_max=%llu "
+            "m_fm=%llu m_fm_avg=%llu m_pm=%llu m_gm=%llu m_major=%llu "
+            "blocks_last=%llu nursery_last=%llu\n",
+            (unsigned long long) fm,
+            (unsigned long long) __atomic_load_n(&bender_probe_fm_skip, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_pm, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_gm, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_major, __ATOMIC_RELAXED),
+            (unsigned long long) marks,
+            (unsigned long long) __atomic_load_n(&bender_probe_marks_max, __ATOMIC_RELAXED),
+            (unsigned long long) mfm,
+            (unsigned long long) (fm ? mfm / fm : 0),
+            (unsigned long long) __atomic_load_n(&bender_probe_marks_pm, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_marks_gm, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_marks_major, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_blocks, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_thresh, __ATOMIC_RELAXED));
+    fprintf(stderr,
+            "[gc-probe-sub] own=%llu dyns=%llu prof=%llu reg=%llu ev=%llu xfb=%llu\n",
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_own, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_dyns, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_prof, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_reg, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_ev, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_sp_xfb, __ATOMIC_RELAXED));
+    fprintf(stderr,
+            "[gc-probe-fib] fibers_fm=%llu fibers_per_fm=%llu fibers_max=%llu\n",
+            (unsigned long long) __atomic_load_n(&bender_probe_fibers_fm, __ATOMIC_RELAXED),
+            (unsigned long long) (fm ? __atomic_load_n(&bender_probe_fibers_fm, __ATOMIC_RELAXED) / fm : 0),
+            (unsigned long long) __atomic_load_n(&bender_probe_fibers_max, __ATOMIC_RELAXED));
+    fprintf(stderr, "[gc-probe-bigsum] big_collections=%llu big_fiber_marks=%llu\n",
+            (unsigned long long) __atomic_load_n(&bender_probe_big_count, __ATOMIC_RELAXED),
+            (unsigned long long) __atomic_load_n(&bender_probe_big_fibers, __ATOMIC_RELAXED));
+}
+
+/* Arming is lazy because the probe must also see collections that run
+ * before any Bender code does. Checked once; atexit prints from the main
+ * thread after every lane has folded its counters in at lane stop. */
+static int bender_probe_armed(void) {
+    if (bender_probe_on < 0) {
+        const char *e = getenv("BENDER_GC_PROBE");
+        bender_probe_on = (NULL != e && '0' != e[0]) ? 1 : 0;
+        if (bender_probe_on) atexit(bender_probe_report);
+    }
+    return bender_probe_on;
+}
+
+/* Reset the per-collection counters at the ENTRY of a collector, so a path
+ * that marks and then returns early cannot leak its marks into the next
+ * collection's attribution. */
+#define BENDER_PROBE_BEGIN() do { \
+    bender_probe_marks_cur = 0; bender_probe_fibers_cur = 0; } while (0)
+
+/* Report any collection whose fiber walk is far larger than the documented
+ * proc-chain bound, with enough identity to say WHICH fiber's minor it was. */
+static void bender_probe_big(const char *kind, BenderFiber *f) {
+    if (bender_probe_on != 1) return;
+    if (bender_probe_fibers_cur < 1000) return;
+    BENDER_PROBE_ADD(bender_probe_big_count, 1);
+    BENDER_PROBE_ADD(bender_probe_big_fibers, bender_probe_fibers_cur);
+    static BENDER_THREAD_LOCAL long shown = 0;
+    if (++shown > 10) return;
+    fprintf(stderr, "[gc-probe-big] %s fiber=%p owner=%u has_proc=%d strict=%d "
+            "fibers=%llu marks=%llu nursery=%lld blocks=%lld lane=%d\n",
+            kind, (void *) f, (NULL != f) ? f->gc_owner : 0,
+            (NULL != f) ? (NULL != f->proc) : -1,
+            (NULL != f) ? f->heap_strict : -1,
+            (unsigned long long) bender_probe_fibers_cur,
+            (unsigned long long) bender_probe_marks_cur,
+            (long long) ((NULL != f) ? (long long) f->gc_nursery_bytes : -1),
+            (long long) bender_vm.block_count,
+            (int) bender_vm.is_lane_vm);
+}
+
+/* Snapshot/fold helpers for per-subpath attribution inside one collection. */
+#define BENDER_PROBE_SUB_BEGIN(v) uint64_t v = bender_probe_marks_cur
+#define BENDER_PROBE_SUB_END(bucket, v) \
+    BENDER_PROBE_ADD(bucket, bender_probe_marks_cur - (v))
+
+/* Fold this collection's thread-local mark count into the totals. */
+static void bender_probe_close(uint64_t *counter, uint64_t *markbucket) {
+    if (!bender_probe_armed()) {
+        bender_probe_marks_cur = 0;
+        return;
+    }
+    BENDER_PROBE_ADD(*counter, 1);
+    BENDER_PROBE_ADD(*markbucket, bender_probe_marks_cur);
+    BENDER_PROBE_ADD(bender_probe_marks, bender_probe_marks_cur);
+    if (bender_probe_marks_cur >
+            __atomic_load_n(&bender_probe_marks_max, __ATOMIC_RELAXED))
+        BENDER_PROBE_SET(bender_probe_marks_max, bender_probe_marks_cur);
+    bender_probe_marks_cur = 0;
+}
+#else
+#define BENDER_PROBE_MARK() ((void)0)
+#define BENDER_PROBE_ADD(p, v) ((void)0)
+#define BENDER_PROBE_SET(p, v) ((void)0)
+#define BENDER_PROBE_SUB_BEGIN(v) ((void)0)
+#define BENDER_PROBE_SUB_END(bucket, v) ((void)0)
+#define BENDER_PROBE_BEGIN() ((void)0)
+#endif
+
