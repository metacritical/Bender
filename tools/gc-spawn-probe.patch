# Spawn-scaling GC probe (development instrumentation, NOT shipped)
#
# Applies to src/core/gc.c. Build with:
#     make -j12 CFLAGS="-O2 -g -DBENDER_GC_PROBE"
# Run with BENDER_GC_PROBE=1 to get, on stderr at exit:
#   [gc-probe]        collection counts per kind, mark totals per kind
#   [gc-probe-sub]    scoped-minor marks split across its six root subpaths
#   [gc-probe-fib]    fibers marked per scoped minor (avg and max)
#   [gc-probe-big]    identity of any collection exceeding the proc-chain bound
#   [gc-probe-bigsum] how many such collections ran, and their total fiber walk
#
# This is what separated "many cheap collections" from "a few whole-live-set
# walks" for docs/internals/proc-spawn-scaling.md. Counters are relaxed-atomic
# folds of per-collection thread-local counts: attribution-grade, not a
# determinism contract.
#
# Apply with:  patch -p0 < tools/gc-spawn-probe.patch
--- src/core/gc.c	2026-10-31 16:56:45
+++ /tmp/gc-with-probe.c	2026-10-31 16:56:45
@@ -182,9 +182,176 @@
