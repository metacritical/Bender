# Hybrid kernels must not erase the VM's resumable quantum boundaries.
(import ./helper :prefix "" :exit true)
(start-suite)
(def root "/tmp/janet-aot-quantum-suite")
(os/execute ["/bin/rm" "-rf" root] :p)
(os/mkdir root)
(def source (string root "/app.janet"))
(def binary (string root "/app"))
(spit source `(defn loop-sum [n]
  (var s 0) (var i 0)
  (while (< i n) (+= s i) (++ i)) s)
(defn caller [n] (loop-sum n))
(defn straight [n] (+ n 1))
(assert (= 499999500000 (caller 1000000)))
(assert (= 42 (straight 41)))
`)
(def env (merge @{} (os/environ) {"JANET_NO_PROFILE" "1"}))
(assert (= 0 (os/execute ["./build/bender" "--aot" source "--native"
                         "--no-auto-pgo" "-o" binary] :e env))
        "hybrid build retains boxed loop and caller")
(def names (string (slurp (string binary "-native/native-names.txt"))))
(assert (not (string/find "loop-sum" names)) "loop has no native wrapper")
(assert (not (string/find "caller" names)) "loop caller has no native wrapper")
(assert (string/find "straight" names) "acyclic kernel still native")
(assert (= 0 (os/execute [binary] :e env)) "boxed loop sum stays exact")
(end-suite)
