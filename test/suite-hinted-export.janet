# Compiler-only retention contract. Scratch paths are controlled by the caller.
(import ./helper :prefix "" :exit true)
(start-suite)
(def src `(defn cold [x] (+ x 2))
(defn hot {:hint {:params [:long] :returns :long}} [x] (+ x 1))
(defn- secret {:hint {:params [:long] :returns :long}} [x] (+ x 3))
nil`)
(defn names [d]
  (map |(get $ :name) (or (get d :defs) @[])))
(defn compile-unit [level analysis]
  (def e (make-env))
  (put e :optimize level)
  (when analysis (put e :retain-hinted-exports-for-analysis (= analysis true)))
  (def forms (parse-all src))
  (def t (compile (tuple/slice @['do ;forms] 0) e))
  (assert (= :function (type t)) "compile returned function")
  t)
(each level [0 1 2]
  (def plain (compile-unit level false))
  (def analysis (compile-unit level true))
  (def pd (disasm plain))
  (def ad (disasm analysis))
  (assert (not (index-of "hot" (names pd))) "default prunes unused hot")
  (assert (index-of "hot" (names ad)) "analysis retains exact hot")
  (assert (not (index-of "cold" (names ad))) "cold pruned")
  (assert (not (index-of "secret" (names ad))) "private pruned")
  (assert (= 1 (length (get ad :defs))) "child index remapped after cold removal")
  (assert (not (some |(= (get $ 0) 'clo) (get ad :bytecode)))
          "orphan retained without runtime closure edge")
  (assert (= (string (marshal plain))
             (string (marshal (compile-unit level :disabled))))
          "absent and explicit-false opt-in yield identical shipping bytes")
  (assert (= "hot" (get (get ((disasm (unmarshal (marshal analysis))) :defs) 0) :name))
          "retained child survives marshal/unmarshal"))
(assert (nil? ((compile-unit 1 false))) "ordinary execution unchanged")
# A surviving closure after a dropped child must have its index remapped
# past the orphaned, retained sibling, not accidentally instantiate hot.
(def remap-env (make-env))
(put remap-env :retain-hinted-exports-for-analysis true)
(def remap-source `(defn cold [x] x)
(defn hot {:hint {:params [:long] :returns :long}} [x] (+ x 1))
(defn live [x] (+ x 10))
(live 32)`)
(def remap-forms (parse-all remap-source))
(def remap-thunk (compile (tuple/slice @['do ;remap-forms] 0) remap-env))
(def remap-disasm (disasm remap-thunk))
(assert (and (= 2 (length (names remap-disasm)))
             (= "hot" (get (names remap-disasm) 0))
             (= "live" (get (names remap-disasm) 1)))
        "cold dropped, orphan before live")
(assert (some |(and (= (get $ 0) 'clo) (= (get $ 2) 1))
              (get remap-disasm :bytecode)) "live closure remapped to index one")
(assert (= 42 (remap-thunk)) "remapped executable closure still runs")
(gccollect)
(assert (= 42 ((unmarshal (marshal remap-thunk))))
        "retained orphan survives GC and marshal without changing execution")

# Sibling function scopes and nested lexical/function scopes can reuse C
# stack addresses. Exact child identities must stay with their own parent.
(def siblings `(defn parent-a [x]
  (do
    (defn a {:hint {:returns :long}} [] 11)
    (defn nested {:hint {:returns :long}} [y]
      (do (defn deep {:hint {:returns :long}} [] 22) y)))
  x)
(defn parent-b [x]
  (do (defn b {:hint {:returns :long}} [] 33))
  x)
(defn parent-c [x]
  (do (defn cold [] 44)
      (defn- private-hint {:hint {:returns :long}} [] 55))
  x)
(+ (parent-a 1) (parent-b 2) (parent-c 3))`)
(each level [0 1 2]
  (def env (make-env))
  (put env :optimize level)
  (put env :retain-hinted-exports-for-analysis true)
  (def forms (parse-all siblings))
  (def old-interval (gcinterval))
  (gcsetinterval 512)
  (def thunk (compile (tuple/slice @['do ;forms] 0) env))
  (gcsetinterval old-interval)
  (gccollect)
  (def d (disasm thunk))
  (def parents (get d :defs))
  (def first-children (get (get parents 0) :defs))
  (assert (and (= 3 (length parents))
               (= "parent-a" (get (names d) 0))
               (= "parent-b" (get (names d) 1))
               (= "parent-c" (get (names d) 2))) "three executable sibling scopes")
  (assert (and (= 2 (length first-children))
               (= "a" (get (names (get parents 0)) 0))
               (= "nested" (get (names (get parents 0)) 1)))
          "first parent owns exactly its two orphan children")
  (assert (= "deep" (get (names (get first-children 1)) 0))
          "nested parent owns its own orphan")
  (assert (and (= 1 (length (get (get parents 1) :defs)))
               (= "b" (get (names (get parents 1)) 0)))
          "second sibling owns b, not first parent's children")
  (assert (= 0 (length (get (get parents 2) :defs)))
          "third sibling does not inherit stale retention")
  (def paths (get env :analysis-retained-hint-paths))
  (assert (and (= 4 (length (keys paths)))
               (get paths "/0/0") (get paths "/0/1")
               (get paths "/0/1/0") (get paths "/1/0"))
          "exact sidecar paths never cross scopes")
  (assert (= 6 (thunk)) "sibling execution unchanged")
  (assert (= 6 ((unmarshal (marshal thunk))))
          "sibling and nested orphans survive GC and remarshal"))

# PGO-selected unhinted public binding: selection is by this unit's
# verified source/line/name, not a global symbol or a runtime root.
(def prof-file "test/fixtures/hinted-export/profile-module.janet")
(def prof-forms (parse-all (slurp prof-file)))
(def prof-ast (tuple/slice @['do ;prof-forms] 0))
(each level [0 1 2]
  (def plain (compile prof-ast (put (make-env) :optimize level) prof-file))
  (def env (make-env))
  (put env :optimize level)
  (put env :retain-hinted-exports-for-analysis true)
  (def selected @{})
  (put selected 'hot 1)
  (put selected 'secret 3)
  (put env :analysis-retain-profiled-defs selected)
  (def analyzed (compile prof-ast env prof-file))
  (gccollect)
  (assert (= 0 (length ((disasm plain) :defs))) "default prunes unhinted exports")
  (assert (and (= 1 (length ((disasm analyzed) :defs)))
               (= "hot" (get (names (disasm analyzed)) 0)))
          "profile retains only unhinted public hot")
  (assert (get (get env :analysis-retained-profile-paths) "/0")
          "profile sidecar maps exact retained child")
  (assert (not (some |(= (get $ 0) 'clo) ((disasm analyzed) :bytecode)))
          "profiled orphan has no executable closure edge")
  (assert (= "hot" (get (names (disasm (unmarshal (marshal analyzed)))) 0))
          "profiled orphan remains intact after GC/remarshal"))
(end-suite)
