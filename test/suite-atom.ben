# Same-VM atoms: atom/deref/swap!/reset!/compare-and-set! (boot.ben).

(import ./helper :prefix "" :exit true)
(start-suite)

(let [a (atom 1)]
  (assert (atom? a) "atom?")
  (assert (not (atom? @{})) "non-atom")
  (assert (= 1 (deref a)) "deref")
  (assert (= 2 (reset! a 2)) "reset returns new")
  (assert (= 2 (deref a)) "reset sticks")
  (assert (= 12 (swap! a + 10)) "swap returns new")
  (assert (= 12 (deref a)) "swap sticks")
  (assert (swap! a (fn [x] (* x 2))) "swap fn")
  (assert (= 24 (deref a)) "swap fn sticks"))

# compare-and-set: true path sets, false path keeps.
(let [a (atom :x)]
  (assert (compare-and-set! a :x :y) "cas hits")
  (assert (= :y (deref a)) "cas set")
  (assert (not (compare-and-set! a :x :z)) "cas misses")
  (assert (= :y (deref a)) "cas miss keeps"))

# Validators gate every writer.
(let [a (atom 0 {:validator pos?})]
  (reset! a 5)
  (assert (= 5 (deref a)) "validator accepts")
  (try (reset! a -1) ([e] (assert (not (nil? (string/find "validator" e))) "reset rejected")))
  (assert (= 5 (deref a)) "rejection keeps old")
  (try (swap! a - 10) ([e] (assert (not (nil? (string/find "validator" e))) "swap rejected")))
  (assert (= 5 (deref a)) "swap rejection keeps old"))

# Independence between atoms.
(let [a (atom 1) b (atom 2)]
  (swap! a inc)
  (assert (= 2 (deref b)) "siblings independent"))

# deref on non-atoms fails loud.
(try (deref 42) ([e] (assert (not (nil? (string/find "atom" e))) "deref refuses")))

(end-suite)
