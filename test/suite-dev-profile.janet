# Interpreter development runs collect diagnostic-only profiles by default.
(import ./helper :prefix "" :exit true)
(start-suite)

(def root "/tmp/janet-development-profile-suite")
(os/execute ["/bin/rm" "-rf" root] :p)
(os/mkdir root)
(def source (string root "/app.janet"))
(spit source "(defn hot [x] (+ x 1))\n(for i 0 40 (hot i))\n")
(def cache (string root "/cache"))
(def env (merge @{} (os/environ) {"XDG_CACHE_HOME" cache
                                    "JANET_PROFILE" "" "JANET_PROFILE_OUT" ""
                                    "JANET_NO_PROFILE" ""}))
(assert (= 0 (os/execute ["./build/bender" source] :e env))
        "ordinary interpreter run succeeds")
(def dir (string cache "/janet/pgo/interpreter"))
(def files (os/dir dir))
(assert (= 1 (length files)) "default interpreter run produces one diagnostic")
(def source-dir (string dir "/" (files 0)))
(def runs (filter (fn [name] (and (string/has-prefix? "run-" name)
                                  (string/has-suffix? ".jdn" name)))
                  (os/dir source-dir)))
(assert (= 1 (length runs)) "first run publishes complete diagnostic")
(assert (os/stat (string source-dir "/cumulative.jdn"))
        "first run also publishes cumulative diagnostics")
(def rows (parse (slurp (string source-dir "/" (runs 0)))))
(assert (> (length rows) 0) "diagnostic includes observed calls")
(assert (nil? (os/stat (string cache "/janet/pgo/app.jdn")))
        "interpreter diagnostic never masquerades as gateable cache")
(assert (= 0 (os/execute ["./build/bender" source]
                         :e (merge @{} env {"JANET_NO_PROFILE" "1"})))
        "sensitive run succeeds with collection disabled")
(assert (= 1 (length (os/dir dir))) "runtime opt-out writes no diagnostic")
(def explicit (string root "/explicit.jdn"))
(assert (= 0 (os/execute ["./build/bender" source]
                         :e (merge @{} env {"JANET_PROFILE" "1"
                                            "JANET_PROFILE_OUT" explicit})))
        "explicit collector run succeeds")
(assert (os/stat explicit) "explicit collector path remains supported")
(assert (= 1 (length (os/dir dir))) "explicit run does not duplicate diagnostic")
(def first-calls (reduce + 0 (map (fn [row] (get (row 1) :calls 0))
                                  (parse (slurp (string source-dir "/cumulative.jdn"))))))
(assert (= 0 (os/execute ["./build/bender" source] :e env))
        "second interpreter run succeeds")
(def second-runs (filter (fn [name] (and (string/has-prefix? "run-" name)
                                          (string/has-suffix? ".jdn" name)))
                         (os/dir source-dir)))
(assert (= 2 (length second-runs)) "second run retained as independent evidence")
(def second-calls (reduce + 0 (map (fn [row] (get (row 1) :calls 0))
                                   (parse (slurp (string source-dir "/cumulative.jdn"))))))
(assert (= (* 2 first-calls) second-calls) "compatible run totals accumulate exactly")
(assert (nil? (os/stat (string cache "/janet/pgo/app.jdn")))
        "cumulative diagnostic never becomes gateable evidence")
# If code changes during the run, neither old nor new bytes authenticate
# the observations. The incomplete dump stays private and cannot aggregate.
(def old-aggregate (string (slurp (string source-dir "/cumulative.jdn"))))
(spit source (string
  "(defn hot [x] (+ x 1))\n"
  "(for i 0 40 (hot i))\n"
  "(spit \"" source "\" \"(print :changed)\\n\")\n"))
(assert (= 0 (os/execute ["./build/bender" source] :e env))
        "self-modifying development run completes")
(assert (= old-aggregate (string (slurp (string source-dir "/cumulative.jdn"))))
        "changed source cannot join previous aggregate")
(assert (= 2 (length (filter (fn [name] (and (string/has-prefix? "run-" name)
                                            (string/has-suffix? ".jdn" name)))
                             (os/dir source-dir))))
        "changed-source run never publishes completed evidence")
(end-suite)
