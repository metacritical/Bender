(import ./helper :prefix "" :exit true)
(start-suite)

(def root (string (os/getenv "BENDER_AOT_TEST_ROOT" "/tmp")
                  "/bender-multiseed-suite-" (os/getpid)))
(assert (nil? (os/stat root)) "test root must be unused")
(os/mkdir root)
(def source (string root "/app.ben"))
(def binary (string root "/app"))
(def cache (string root "/cache"))
(spit source "(defn varied [x] (if (number? x) (+ x 1) (string x \"!\")))\n(defn sample [xs] (length xs))\n(def arg (get (dyn :args) 1))\n(print (varied (if (= arg \"7\") \"seven\" 42)) \" \" (sample (if (= arg \"7\") @[\"s\"] @[1])))\n")
(def env (merge @{} (os/environ)
                {"XDG_CACHE_HOME" cache "BENDER_NO_PROFILE" "1"}))
(defn build [opts]
  (os/execute ["./build/bender" "--aot" source "--native" ;opts "-o" binary] :e env))
(assert (= 0 (build ["--pgo" "42"])) "first workload")
(def dir (string cache "/bender/pgo"))
(def first-meta-path (string dir "/app.meta"))
(def first-meta (string (slurp first-meta-path)))
(def first-record ((get (parse first-meta) :workloads) 0))
(def original-oracle (string (slurp (get first-record :oracle))))
(def first-profile (string (slurp (get first-record :profile))))
(def first-aggregate (string (slurp (get (parse first-meta) :aggregate))))
(def first-binary (string (slurp binary)))
(spit (get first-record :oracle) "intentionally altered prior oracle\n")
(def altered-oracle (string (slurp (get first-record :oracle))))
(assert (not= 0 (build ["--pgo" "7"])) "new training must verify prior oracle")
(assert (= first-meta (string (slurp first-meta-path))) "failed collect preserves manifest")
(assert (= first-profile (string (slurp (get first-record :profile))))
        "failed collect preserves prior raw profile")
(assert (= first-aggregate (string (slurp (get (parse first-meta) :aggregate))))
        "failed collect preserves prior aggregate")
(assert (= altered-oracle (string (slurp (get first-record :oracle))))
        "failed collect does not rewrite prior oracle")
(assert (= first-binary (string (slurp binary))) "failed collect preserves binary")
(spit (get first-record :oracle) original-oracle)
(assert (= 0 (build ["--pgo" "7"])) "second workload after restoring oracle")
(def records (get (parse (slurp (string dir "/app.meta"))) :workloads))
(assert (= 2 (length records)) "both independent workloads retained")
(def joined (parse (slurp (get (parse (slurp (string dir "/app.meta"))) :aggregate))))
(def varied (find (fn [row] (= "varied" (get (row 0) 2))) joined))
(def sample (find (fn [row] (= "sample" (get (row 0) 2))) joined))
(assert (deep= @[:number :string] (sorted (distinct (get (get (varied 1) :params) 0))))
        "merged param retains conflicting types")
(assert (deep= @[:number :string] (sorted (distinct (get (get (sample 1) :elems) 0))))
        "merged sampled elements retain conflicting hints")
(assert (not= (slurp (get (records 0) :oracle))
              (slurp (get (records 1) :oracle))) "distinct oracles")
(def first-raw (parse (slurp (get (records 0) :profile))))
(assert (= 0 (build ["--pgo" "42"])) "repeat identical workload")
(def repeated (get (parse (slurp (string dir "/app.meta"))) :workloads))
(assert (= 2 (length repeated)) "repeat does not add workload")
(def again (parse (slurp (get (repeated 0) :profile))))
(assert (> (get ((find (fn [row] (= "varied" (get (row 0) 2))) again) 1) :calls)
           (get ((find (fn [row] (= "varied" (get (row 0) 2))) first-raw) 1) :calls))
        "repeat accumulates raw calls")
(assert (= 0 (build ["--release"])) "all trained workloads replay")
(var installed (string (slurp binary)))
(def valid-v3 (string (slurp (string dir "/app.meta"))))
(def invalid-aggregate (merge (parse valid-v3)))
(put invalid-aggregate :aggregate nil)
(spit (string dir "/app.meta")
      (string/format "%j" invalid-aggregate))
(assert (not= 0 (build ["--pgo" "42"])) "missing v3 aggregate rejects collection")
(assert (= installed (string (slurp binary))) "invalid metadata cannot install")
(spit (string dir "/app.meta") valid-v3)
(def missing-oracle (parse valid-v3))
(def invalid-records (array/slice (get missing-oracle :workloads)))
(def invalid-first (merge (invalid-records 0)))
(put invalid-first :oracle nil)
(put invalid-records 0 invalid-first)
(spit (string dir "/app.meta")
      (string/format "%j" (merge missing-oracle {:workloads invalid-records})))
(assert (= 0 (build ["--pgo" "42"]))
        "oracle-less v3 record is repaired by collection")
(def repaired (parse (slurp (string dir "/app.meta"))))
(def repaired-first (get (get repaired :workloads) 0))
(assert (and (string? (get repaired-first :oracle))
             (= :file (os/stat (get repaired-first :oracle) :mode)))
        "repair persists the regenerated oracle")
(set installed (string (slurp binary)))
# A fault after staging a new generation but before publishing its manifest
# must preserve all previously referenced evidence and the installed binary.
(def manifest-before (string (slurp (string dir "/app.meta"))))
(def raw-before (string (slurp (get (repeated 0) :profile))))
(def oracle-before (string (slurp (get (repeated 0) :oracle))))
(def fault-env (merge @{} env {"BENDER_PGO_FAIL_BEFORE_MANIFEST" "1"}))
(assert (not= 0 (os/execute ["./build/bender" "--aot" source "--native" "--pgo" "42"
                            "-o" binary] :e fault-env)) "pre-publish fault blocks install")
(assert (= manifest-before (string (slurp (string dir "/app.meta"))))
        "pre-publish fault leaves previous manifest unchanged")
(assert (= raw-before (string (slurp (get (repeated 0) :profile))))
        "pre-publish fault leaves previous raw profile intact")
(assert (= oracle-before (string (slurp (get (repeated 0) :oracle))))
        "pre-publish fault leaves previous oracle intact")
(assert (= installed (string (slurp binary))) "pre-publish fault leaves binary intact")
(assert (= 0 (build ["--release"])) "previous manifest still replays every workload")
(set installed (string (slurp binary)))
(spit (get (repeated 1) :oracle) "tampered oracle\n")
(assert (not= 0 (build ["--release"])) "any incorrect oracle blocks release")
(assert (= installed (string (slurp binary))) "failed gate leaves installed binary intact")
(spit source (string (slurp source) "\n# edited\n"))
(assert (not= 0 (build ["--release"])) "changed source rejects evidence")
(assert (= installed (string (slurp binary))) "source mismatch cannot install")
(def input-a (string root "/input-a"))
(def input-b (string root "/input-b"))
(def other (string root "/stdin-app"))
(spit input-a "first\x00bytes")
(spit input-b "second\nbytes")
(spit source "(print 42)\n")
(defn stdin-build [path]
  (os/execute ["./build/bender" "--aot" source "--native" "--pgo" ""
               "--pgo-stdin" path "-o" other] :e env))
(assert (= 0 (stdin-build input-a)) "first stdin workload")
(assert (= 0 (stdin-build input-b)) "second stdin workload")
(def inputs (get (parse (slurp (string dir "/stdin-app.meta"))) :workloads))
(assert (= 2 (length inputs)) "same argv with different stdin bytes stays distinct")
(assert (not= (get (inputs 0) :stdin-bytes) (get (inputs 1) :stdin-bytes))
        "stdin bytes retained independently")
(assert (= 0 (os/execute ["./build/bender" "--aot" source "--native" "--release"
                          "-o" other] :e env)) "both stdin workloads replay")
(end-suite)
