# Regression: call-site conflicts must not resurrect a numeric specialization.
(import ./helper :prefix "" :exit true)
(import ../tools/infer :as infer)
(start-suite)
(assert (= :any (infer/narrow :long :string)) "numeric/string conflict stays boxed")
(assert (= :any (infer/narrow :any :long)) "later numeric evidence cannot erase conflict")
(assert (= :any (infer/narrow :keyword :long)) "keyword/numeric conflict stays boxed")
(assert (= :long (infer/narrow :unknown :long)) "unseen slot can specialize")
(defn union-identity [x] x)
(assert (= 1 (union-identity 1)) "number identity")
(assert (= "s" (union-identity "s")) "string identity")
(assert (= :k (union-identity :k)) "keyword identity")
(assert (= 2 (union-identity 2)) "numeric call after conflict")
(end-suite)
